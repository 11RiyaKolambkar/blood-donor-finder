# =============================================================================
# PulseNet Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Port the Express server will listen on
PORT=5000

# Node environment: development | production | test
NODE_ENV=development

# Frontend/app origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Database — MongoDB
# -----------------------------------------------------------------------------

# Full MongoDB connection URI (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/pulsenet

# Database name (overrides the name in MONGODB_URI if set)
MONGODB_DB_NAME=pulsenet

# MongoDB connection pool size
MONGODB_POOL_SIZE=10

# -----------------------------------------------------------------------------
# Cache — Redis (optional — set REDIS_ENABLED=false to disable)
# -----------------------------------------------------------------------------

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Redis key prefix to namespace PulseNet keys
REDIS_KEY_PREFIX=pulsenet:

# Default TTL for cached values (seconds)
REDIS_DEFAULT_TTL=300

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------

# Secret used to sign access tokens — CHANGE THIS in production!
# Generate a strong random value: `openssl rand -hex 64`
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_64_chars_long_replace_before_deploy

# Secret used to sign refresh tokens — must differ from access secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_64_chars_long_replace_before_deploy

# Access token expiry (ms/s/m/h/d notation)
JWT_ACCESS_EXPIRY=15m

# Refresh token expiry
JWT_REFRESH_EXPIRY=7d

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# bcrypt hashing rounds (12 is recommended for production)
BCRYPT_ROUNDS=12

# Rate limit: max requests per window per IP
RATE_LIMIT_MAX=100

# Rate limit window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# API key for internal service-to-service calls (optional)
INTERNAL_API_KEY=CHANGE_ME_internal_api_key

# -----------------------------------------------------------------------------
# External Services — Firebase Cloud Messaging (FCM)
# -----------------------------------------------------------------------------

# Set to true to enable FCM push notifications
FCM_ENABLED=false

# Firebase project ID
FCM_PROJECT_ID=your-firebase-project-id

# Path to Firebase service account JSON key file
# (or use FCM_SERVICE_ACCOUNT_JSON for the JSON string directly)
FCM_SERVICE_ACCOUNT_KEY_PATH=./config/firebase-service-account.json

# Alternatively, embed the JSON directly (useful in containerised envs):
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# -----------------------------------------------------------------------------
# External Services — Google Maps
# -----------------------------------------------------------------------------

# Set to true to enable Google Maps features
GOOGLE_MAPS_ENABLED=false

# Server-side Maps API key (restrict to your server IPs in GCP console)
GOOGLE_MAPS_API_KEY=your-google-maps-server-api-key

# -----------------------------------------------------------------------------
# External Services — Razorpay Payments
# -----------------------------------------------------------------------------

# Set to true to enable Razorpay payment features
RAZORPAY_ENABLED=false

# Razorpay key ID (starts with rzp_test_ for test mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id

# Razorpay key secret — keep this private
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook secret for validating Razorpay webhook signatures
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable geospatial donor search
FEATURE_DONOR_SEARCH=true

# Enable emergency SOS functionality
FEATURE_EMERGENCY_SOS=true

# Enable blood bank inventory management
FEATURE_BLOOD_BANK_INVENTORY=true

# Enable payment processing
FEATURE_PAYMENTS=false

# Enable live location sharing during emergencies
FEATURE_LIVE_LOCATION=false

# Enable analytics collection
FEATURE_ANALYTICS=false

# Enable AI assistance features (must have explicit consent per user)
FEATURE_AI_ASSISTANCE=false

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log level: error | warn | info | http | debug
LOG_LEVEL=info

# Log format: json | pretty (use json in production)
LOG_FORMAT=pretty

# Directory for log files (leave blank to log to stdout only)
LOG_DIR=./logs

# Rotate logs after this size (e.g. 20m, 1g)
LOG_MAX_SIZE=20m

# Keep logs for this many days
LOG_MAX_DAYS=14d

# -----------------------------------------------------------------------------
# Monitoring (optional)
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=

# Application version tag for Sentry releases
APP_VERSION=1.0.0
